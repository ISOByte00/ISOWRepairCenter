<Window x:Class="ISOWRepairCenter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:ISOWRepairCenter.ViewModels" Title="{Binding L[WindowTitle]}" Width="1180" Height="790" MinWidth="960" MinHeight="650" Background="{StaticResource AppBackground}" Foreground="{StaticResource TextBrush}">
  <Window.DataContext><vm:MainViewModel/></Window.DataContext>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding L[AppTitle]}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding L[Subtitle]}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding L[Language]}" Margin="0,5,8,0"/><ComboBox Width="105" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage}"/><Button Content="{Binding L[About]}" Click="About_Click" Padding="10,5" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding AdministratorStatus}" Foreground="#86EFAC" HorizontalAlignment="Right" Margin="0,6,0,0"/><TextBlock Text="{Binding WindowsStatus}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></StackPanel>
    </Grid>
    <TabControl Grid.Row="1" Background="{StaticResource PanelBackground}" BorderThickness="0">
      <TabItem Header="{Binding L[Dashboard]}"><ScrollViewer><StackPanel Margin="24"><TextBlock Text="{Binding L[Status]}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Margin="0,8,0,18" TextWrapping="Wrap"/><Border Background="#172033" Padding="16"><StackPanel><TextBlock Text="{Binding L[SessionStorage]}" FontWeight="SemiBold"/><TextBlock Text="{Binding L[SessionText]}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/><TextBlock Text="{Binding LastSession}" TextWrapping="Wrap"/></StackPanel></Border><Border Background="#172033" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="{Binding L[Diagnostics]}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Findings}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Evidence}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Recommendation}" Foreground="#93C5FD" FontSize="12" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="{Binding L[OpenSession]}" Click="OpenSession_Click" IsEnabled="{Binding CanStart}"/><Button Content="{Binding L[Cancel]}" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" Background="#B91C1C"/></StackPanel></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{Binding L[Diagnostics]}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox ItemsSource="{Binding Diagnostics}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding Risk}" Foreground="#93C5FD" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="1" Content="{Binding L[RunDiagnostics]}" Click="RunDiagnostics_Click" IsEnabled="{Binding CanStart}" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></TabItem>
      <TabItem Header="{Binding L[SafeRepairs]}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#172033" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding L[DismSource]}" FontWeight="SemiBold"/><TextBlock Text="{Binding L[DismHint]}" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBox Text="{Binding DismSource, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/></StackPanel></Border><ListBox Grid.Row="1" ItemsSource="{Binding SafeRepairs}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding Risk}" Foreground="#FCD34D" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="{Binding L[RunSafe]}" Click="RunSafeRepairs_Click" IsEnabled="{Binding CanStart}" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></TabItem>
      <TabItem Header="{Binding L[ExpertRepairs]}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#3F1D1D" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding L[ExpertWarning]}" FontWeight="SemiBold"/><TextBlock Text="{Binding L[BcdHint]}" Foreground="#FECACA" TextWrapping="Wrap"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding L[WindowsSource]}"/><TextBox Text="{Binding WindowsSource, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding L[EfiTarget]}"/><TextBox Text="{Binding EfiTarget, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid></StackPanel></Border><ListBox Grid.Row="1" ItemsSource="{Binding ExpertRepairs}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding Risk}" Foreground="#FCA5A5" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="{Binding L[RunExpert]}" Click="RunExpertRepairs_Click" IsEnabled="{Binding CanStart}" HorizontalAlignment="Left" Margin="0,12,0,0" Background="#B91C1C"/></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#0B1220" Margin="0,16,0,12" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding LiveLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" Background="Transparent" Foreground="#C4E5FF" BorderThickness="0" FontFamily="Consolas"/></ScrollViewer></Border>
    <StackPanel Grid.Row="3"><TextBlock Text="{Binding L[Footer]}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding L[Copyright]}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
  </Grid>
</Window>
